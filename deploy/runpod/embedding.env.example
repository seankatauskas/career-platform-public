# Copy outside the repository and source it before using
# scripts/runpod-embedding-endpoint. Never put RUNPOD_API_KEY in this file.

RUNPOD_EMBEDDING_TEMPLATE_NAME=job-search-bge-template
RUNPOD_EMBEDDING_ENDPOINT_NAME=job-search-bge
# Build Dockerfile.runpod-embedding, push it to your registry, and pin that
# derivative image here. The stock worker is intentionally rejected.
RUNPOD_EMBEDDING_WORKER_IMAGE=YOUR_REGISTRY/job-search-embedding@sha256:REPLACE_WITH_64_HEX_IMAGE_DIGEST
RUNPOD_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Pin a Hugging Face commit, never a mutable branch such as main.
RUNPOD_EMBEDDING_MODEL_REFERENCE=https://huggingface.co/BAAI/bge-base-en-v1.5:REPLACE_WITH_COMMIT_SHA
RUNPOD_EMBEDDING_DIMENSIONS=768
RUNPOD_EMBEDDING_BATCH_SIZE=32
RUNPOD_EMBEDDING_GPU_ID=REPLACE_WITH_GPU_POOL_ID
RUNPOD_EMBEDDING_CONTAINER_DISK_GB=20
RUNPOD_EMBEDDING_IDLE_TIMEOUT=300
RUNPOD_EMBEDDING_EXECUTION_TIMEOUT=900

# Fill these from the verified identifiers printed by template/deploy.
RUNPOD_EMBEDDING_TEMPLATE_ID=
RUNPOD_EMBEDDING_ENDPOINT_ID=
