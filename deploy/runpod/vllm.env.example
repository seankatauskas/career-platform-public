# Copy outside the repository and source it before using
# scripts/runpod-vllm-endpoint. Never put RUNPOD_API_KEY in this file.

RUNPOD_ENDPOINT_NAME=job-search-vacation-llm
RUNPOD_TEMPLATE_NAME=job-search-vllm-template
# Resolve a reviewed worker-vLLM release to its registry digest. Tags are rejected.
RUNPOD_WORKER_IMAGE=runpod/worker-v1-vllm@sha256:REPLACE_WITH_64_HEX_IMAGE_DIGEST
RUNPOD_MODEL_NAME=REPLACE_ORG/REPLACE_MODEL
# Pin a Hugging Face commit, never a mutable branch such as main.
RUNPOD_MODEL_REFERENCE=https://huggingface.co/REPLACE_ORG/REPLACE_MODEL:REPLACE_WITH_COMMIT_SHA
RUNPOD_GPU_ID=REPLACE_WITH_GPU_POOL_OR_TYPE
RUNPOD_CONTAINER_DISK_GB=20
RUNPOD_MAX_MODEL_LEN=32768
RUNPOD_IDLE_TIMEOUT=300
RUNPOD_EXECUTION_TIMEOUT=900

# Fill these from the verified identifiers printed by template/deploy.
RUNPOD_TEMPLATE_ID=
RUNPOD_ENDPOINT_ID=
