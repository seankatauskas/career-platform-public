#!/command/with-contenv sh
set -eu

# The preceding upstream hook has already remapped the hermes user to HERMES_UID.
# Put the MCP bearer token only in s6's in-memory environment, never in Compose or
# the persistent Hermes .env file. Supervised gateways can then resolve ${...} in
# their MCP header configuration.
expected_base="${JOB_SEARCH_EXPECTED_HERMES_BASE_IMAGE:-}"
built_base="${JOB_SEARCH_BUILT_HERMES_BASE_IMAGE:-}"
base_ref="${expected_base%@sha256:*}"
digest="${expected_base##*@sha256:}"
if [ -z "$base_ref" ] || \
   [ "$expected_base" != "$base_ref@sha256:$digest" ] || \
   [ "${#digest}" -ne 64 ]; then
  >&2 printf '%s\n' 'job-search Hermes requires a digest-pinned upstream image'
  exit 1
fi
case "$digest" in
  *[!0-9a-f]*)
    >&2 printf '%s\n' 'job-search Hermes upstream digest is invalid'
    exit 1
    ;;
esac
if [ "$built_base" != "$expected_base" ]; then
  >&2 printf '%s\n' 'job-search Hermes image does not match the expected upstream digest'
  exit 1
fi

exec /opt/hermes/.venv/bin/python \
  /opt/job-search-hermes/hermes_delivery.py \
  install-mcp-environment \
  --token-file /run/job-search-mcp-token \
  --environment-directory /run/s6/container_environment \
  --owner-name hermes
